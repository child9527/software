{% if section["items"] %}
<div class="section-title">{{ section.title }}</div>

<div class="filter-container">
{% for t in section.types %}
    <button class="filter-btn{% if loop.first %} active{% endif %}"
            onclick="filterSourceType(this)">{{ t }}</button>
{% endfor %}
</div>

<div class="compact-grid">
{% for item in section["items"] %}
    <div class="source-card{% if item.type != section.first_type %} hidden{% endif %}"
         data-type="{{ item.type }}">
        <div class="source-name">{{ item.name }}</div>
        <button class="copy-btn" onclick='copyUrl(this, {{ item.url_literal | safe }})'>
            复制链接
        </button>
    </div>
{% endfor %}
</div>
{% endif %}
